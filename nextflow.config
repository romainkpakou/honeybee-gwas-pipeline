/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    honeybee-gwas-pipeline — Nextflow Configuration
    Auteur  : Romain KPAKOU
    Version : 1.0.0
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

// ── Manifest ─────────────────────────────────────────────────────────────────
// Définit les métadonnées du pipeline
// manifest.version est accessible dans main.nf via ${manifest.version}
manifest {
    name            = 'honeybee-gwas-pipeline'
    author          = 'Romain KPAKOU'
    description     = 'WGS and GWAS pipeline for Apis mellifera mellifera'
    version         = '1.0.0'
    nextflowVersion = '>=23.04.0'
    homePage        = 'https://github.com/romainkpakou/honeybee-gwas-pipeline'
    mainScript      = 'main.nf'
}

// ── Paramètres par défaut ─────────────────────────────────────────────────────
params {
    // Entrée / Sortie
    input           = null
    outdir          = 'results'
    genome          = null
    gff             = null                // annotation GFF3 → active SnpEff
    genome_species  = 'Apis mellifera'
    phenotype_file  = null

    // QC reads
    min_quality     = 20
    min_length      = 50

    // Alignement
    bwa_threads     = 8

    // GATK
    gatk_java       = '-Xmx8g'
    markdup_java    = '-Xmx8g'
    snp_qd          = 2.0
    snp_fs          = 60.0
    snp_mq          = 40.0
    snp_sor         = 3.0
    snp_mqranksum   = -12.5
    snp_readposrank = -8.0

    // Génétique des populations / GWAS
    maf             = 0.05
    geno            = 0.05
    mind            = 0.10
    hwe             = 1e-6
    hwe_filter      = false      // filtrer les SNPs hors équilibre HW (souvent
                                 // à éviter en population structurée A/M/C)
    ld_window       = 50
    ld_step         = 10
    ld_r2           = 0.2
    pca_components   = 20        // nombre de PC (doit être < nb d'individus)
    plink_bad_ld    = false      // forcer l'élagage LD si < 50 individus
    admixture_k     = '2,3,4,5'
    gwas_model      = 'lmm'
    gwas_pval       = 1e-6

    // Plafonds de ressources — appliqués à tous les process via resourceLimits
    max_cpus        = 8
    max_memory      = '14.GB'
    max_time        = '72.h'

    help            = false
}

// ── Ressources par processus ──────────────────────────────────────────────────
process {
    // Plafond global : aucune tâche ne peut demander plus que ces valeurs,
    // quelles que soient les directives withName ci-dessous (Nextflow ≥ 24.04)
    resourceLimits = [
        cpus  : params.max_cpus,
        memory: params.max_memory,
        time  : params.max_time
    ]

    cpus          = 4
    memory        = '8.GB'
    time          = '4.h'
    errorStrategy = 'retry'
    maxRetries    = 2

    withName: 'FASTQC'                { cpus = 2;  memory = '4.GB';  time = '2.h'  }
    withName: 'FASTP'                 { cpus = 4;  memory = '8.GB';  time = '4.h'  }
    withName: 'BWA_MEM2_INDEX'        { cpus = 4;  memory = '8.GB';  time = '3.h'  }
    withName: 'BWA_MEM2_ALIGN'        { cpus = 4;  memory = '12.GB'; time = '12.h' }
    withName: 'PICARD_MARKDUPLICATES' { cpus = 2;  memory = '8.GB'; time = '8.h'  }
    withName: 'GATK_HAPLOTYPECALLER'  { cpus = 2;  memory = '8.GB'; time = '24.h' }
    withName: 'GATK_GENOTYPEGVCFS'    { cpus = 2;  memory = '8.GB'; time = '12.h' }
    withName: 'SNPEFF_BUILD'         { cpus = 2;  memory = '8.GB';  time = '3.h'  }
    withName: 'SNPEFF_ANNOTATE'      { cpus = 2;  memory = '8.GB';  time = '2.h'  }
    withName: 'GEMMA_KINSHIP'        { cpus = 4;  memory = '8.GB';  time = '12.h' }
    withName: 'GEMMA_LMM'             { cpus = 4;  memory = '8.GB';  time = '24.h' }
    withName: 'ADMIXTURE_RUN'         { cpus = 4;  memory = '8.GB'; time = '12.h' }
}

// ── Profils d'exécution ───────────────────────────────────────────────────────
profiles {

    // Exécution locale avec Docker
    local {
        process.executor  = 'local'
        docker.enabled    = true
        docker.runOptions = '-u $(id -u):$(id -g)'
    }

    // Docker (profil par défaut pour développement)
    docker {
        docker.enabled      = true
        docker.runOptions   = '-u $(id -u):$(id -g)'
        singularity.enabled = false
    }

    // Singularity (HPC sans Docker)
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false
    }

    // SLURM + Singularity (cluster HPC)
    slurm {
        process.executor       = 'slurm'
        process.queue          = 'normal'
        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false
    }

    // Profil stub : fixtures minimales versionnées, pour `nextflow run -stub`
    // (CI). Ne lance aucun outil — valide uniquement le câblage du workflow.
    stub {
        params {
            input  = "${projectDir}/test/stub/samplesheet.csv"
            genome = "${projectDir}/test/stub/genome.fa"
            gff    = "${projectDir}/test/stub/genome.gff.gz"
            outdir = 'stub_results'
            pca_components = 2
            admixture_k    = '2'
        }
    }

    // Profil de démonstration : 5 échantillons WGS (bin/download_data.sh 5)
    // Filtres QC volontairement relâchés — les résultats GWAS/popgen n'ont
    // PAS de valeur biologique, c'est un test de bout en bout du pipeline.
    test {
        params {
            input          = "${projectDir}/samplesheet.csv"
            genome         = "${projectDir}/data/reference/Amel_HAv3.1.fa"
            gff            = "${projectDir}/data/reference/Amel_HAv3.1.gff.gz"
            outdir         = 'results'
            maf            = 0.01
            geno           = 0.5
            mind           = 0.5
            admixture_k    = '2,3'
            pca_components  = 4
            plink_bad_ld   = true
        }
        process {
            cpus   = 2
            memory = '4.GB'
            time   = '2.h'
        }
    }
}

// ── Rapports d'exécution ──────────────────────────────────────────────────────
// overwrite = true : écrase les fichiers existants entre deux runs
timeline {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/timeline.html"
}
report {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/report.html"
}
trace {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/trace.txt"
}
dag {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/dag.svg"
}
