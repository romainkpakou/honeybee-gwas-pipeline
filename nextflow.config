/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    honeybee-gwas-pipeline — Nextflow Configuration
    Author  : Romain KPAKOU
    Version : 1.0.0
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

manifest {
    name            = 'honeybee-gwas-pipeline'
    author          = 'Romain KPAKOU'
    description     = 'WGS and GWAS pipeline for Apis mellifera mellifera'
    version         = '1.0.0'
    nextflowVersion = '>=23.04.0'
    homePage        = 'https://github.com/romainkpakou/honeybee-gwas-pipeline'
    mainScript      = 'main.nf'
}

// ── Paramètres par défaut ─────────────────────────────────────────────────────
params {

    // Entrée / Sortie
    input           = null
    outdir          = 'results'
    genome          = null
    phenotype_file  = null

    // QC reads
    min_quality     = 20
    min_length      = 50

    // Alignement
    bwa_threads     = 8

    // GATK — filtres hard-filter SNPs (GATK Best Practices)
    gatk_java       = '-Xmx8g'
    snp_qd          = 2.0
    snp_fs          = 60.0
    snp_mq          = 40.0
    snp_sor         = 3.0
    snp_mqranksum   = -12.5
    snp_readposrank = -8.0

    // Génétique des populations / GWAS
    maf             = 0.05
    geno            = 0.05
    mind            = 0.10
    hwe             = 1e-6
    ld_window       = 50
    ld_step         = 10
    ld_r2           = 0.2
    admixture_k     = '2,3,4,5'
    gwas_model      = 'lmm'
    gwas_pval       = 1e-6

    // Ressources maximales
    max_cpus        = 16
    max_memory      = '64.GB'
    max_time        = '72.h'

    help            = false
}

// ── Ressources par processus ──────────────────────────────────────────────────
process {
    cpus          = 4
    memory        = '8.GB'
    time          = '4.h'
    errorStrategy = { task.exitStatus in [143,137,104,134,139] ? 'retry' : 'finish' }
    maxRetries    = 2

    withName: 'FASTQC'                { cpus = 2;  memory = '4.GB';  time = '2.h'  }
    withName: 'FASTP'                 { cpus = 4;  memory = '8.GB';  time = '4.h'  }
    withName: 'BWA_MEM2_ALIGN'        { cpus = 8;  memory = '32.GB'; time = '12.h' }
    withName: 'PICARD_MARKDUPLICATES' { cpus = 4;  memory = '16.GB'; time = '8.h'  }
    withName: 'GATK_HAPLOTYPECALLER'  { cpus = 4;  memory = '16.GB'; time = '24.h' }
    withName: 'GATK_GENOTYPEGVCFS'    { cpus = 4;  memory = '16.GB'; time = '12.h' }
    withName: 'GEMMA_LMM'             { cpus = 8;  memory = '32.GB'; time = '24.h' }
    withName: 'ADMIXTURE_RUN'         { cpus = 8;  memory = '16.GB'; time = '12.h' }
}

// ── Profils d'exécution ───────────────────────────────────────────────────────
profiles {

    local {
        process.executor    = 'local'
        docker.enabled      = true
        docker.runOptions   = '-u $(id -u):$(id -g)'
    }

    docker {
        docker.enabled      = true
        docker.runOptions   = '-u $(id -u):$(id -g)'
        singularity.enabled = false
    }

    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false
    }

    slurm {
        process.executor       = 'slurm'
        process.queue          = 'normal'
        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false
    }

    test {
        params.input   = "${projectDir}/test/test_samplesheet.csv"
        params.genome  = "${projectDir}/test/test_data/test_genome.fa"
        params.outdir  = 'test_results'
        process.cpus   = 2
        process.memory = '4.GB'
        process.time   = '1.h'
    }
}

// ── Rapports d'exécution ──────────────────────────────────────────────────────
timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/timeline.html"
}
report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/report.html"
}
trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/trace.txt"
}
dag {
    enabled = true
    file    = "${params.outdir}/pipeline_info/dag.svg"
}
